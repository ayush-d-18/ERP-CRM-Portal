generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  customers    Customer[]
  challans     SalesChallan[]
  movements    StockMovement[]
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  mobile         String
  email          String         @unique
  businessName   String?
  gstNumber      String?
  customerType   CustomerType   @default(RETAIL)
  address        String?
  status         CustomerStatus @default(LEAD)
  followUpDate   DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedToId   String?
  assignedTo     User?          @relation(fields: [assignedToId], references: [id])
  challans       SalesChallan[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  sku              String   @unique
  category         String?
  unitPrice        Float
  currentStock     Int      @default(0)
  minStockLevel    Int      @default(10)
  warehouse        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements        StockMovement[]
  challanItems     ChallanItem[]
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Int
  type        MovementType
  reason      String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

model SalesChallan {
  id             String        @id @default(cuid())
  challanNumber  String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         ChallanStatus @default(DRAFT)
  totalAmount    Float         @default(0)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          ChallanItem[]
}

model ChallanItem {
  id            String       @id @default(cuid())
  challanId     String
  challan       SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  productName   String
  productSku    String
  unitPrice     Float
  quantity      Int
  totalPrice    Float
}
